
pipeline {
    agent any

    environment {
        IMAGE_NAME = 'pathnex-nginx'
        DOCKERHUB_USER = 'your-dockerhub-username'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    docker.build(
                        "${env.DOCKERHUB_USER}/${env.IMAGE_NAME}:latest"
                    )
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                script {
                    docker.withRegistry(
                        'https://index.docker.io/v1/',
                        'docker-credentials'
                    ) {
                        docker.image(
                            "${env.DOCKERHUB_USER}/${env.IMAGE_NAME}:latest"
                        ).push()
                    }
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                sh 'kubectl apply -f coding-practice/Day13/kubernetes/nginx-config-secret.yaml'
            }
        }
    }

    post {
        success {
            echo 'Build and deployment pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Please check the Jenkins console logs.'
        }
    }
}
