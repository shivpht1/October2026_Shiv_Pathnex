cat > coding-practice/Day21/jenkins/Jenkinsfile <<'EOF'
pipeline {
    agent any

    environment {
        BACKUP_DIR = '/tmp/jenkins-backups'
        BACKUP_FILE = 'workspace-backup.tar.gz'
        RESTORE_DIR = '/tmp/jenkins-restore'
    }

    stages {
        stage('Prepare Backup Directory') {
            steps {
                sh '''
                    mkdir -p "$BACKUP_DIR"
                    mkdir -p "$RESTORE_DIR"
                '''
            }
        }

        stage('Create Workspace Backup') {
            steps {
                sh '''
                    tar -czf "$BACKUP_DIR/$BACKUP_FILE" \
                        -C "$WORKSPACE" .
                '''
            }
        }

        stage('Verify Backup') {
            steps {
                sh '''
                    test -s "$BACKUP_DIR/$BACKUP_FILE"
                    tar -tzf "$BACKUP_DIR/$BACKUP_FILE" > /dev/null
                    echo "Backup archive verified successfully."
                '''
            }
        }

        stage('Test Restore') {
            steps {
                sh '''
                    tar -xzf "$BACKUP_DIR/$BACKUP_FILE" \
                        -C "$RESTORE_DIR"

                    echo "Restore test completed."
                    ls -la "$RESTORE_DIR"
                '''
            }
        }
    }

    post {
        success {
            echo 'Backup and restore verification completed successfully.'
        }

        failure {
            echo 'Pipeline failed. Check the Jenkins console output.'
        }

        always {
            echo 'Backup pipeline execution finished.'
        }
    }
}
EOF